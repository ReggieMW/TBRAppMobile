<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TBRAppMobile.Pages.BookViewPage"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource AccentColor}">
       <!--Page for viewing an individual book and all properties, many updates to come! -->

       <ContentPage.Resources>
              <!-- Small primary button (stays primary on press/disabled) -->
              <Style x:Key="TinyPrimaryButton"
                     TargetType="Button">
                     <Setter Property="BackgroundColor"
                             Value="{DynamicResource PrimaryColor}"/>
                     <Setter Property="TextColor"
                             Value="White"/>
                     <Setter Property="FontSize"
                             Value="12"/>
                     <Setter Property="Padding"
                             Value="10,6"/>
                     <Setter Property="CornerRadius"
                             Value="12"/>
                     <Setter Property="BorderColor"
                             Value="{DynamicResource PrimaryColor}"/>
                     <Setter Property="BorderWidth"
                             Value="1"/>
                     <Setter Property="VisualStateManager.VisualStateGroups">
                            <VisualStateGroupList>
                                   <VisualStateGroup x:Name="CommonStates">
                                          <VisualState x:Name="Normal">
                                                 <VisualState.Setters>
                                                        <Setter Property="BackgroundColor"
                                                                Value="{DynamicResource PrimaryColor}"/>
                                                        <Setter Property="Opacity"
                                                                Value="1"/>
                                                 </VisualState.Setters>
                                          </VisualState>
                                          <VisualState x:Name="Pressed">
                                                 <VisualState.Setters>
                                                        <!-- Keep primary; subtle feedback via opacity -->
                                                        <Setter Property="BackgroundColor"
                                                                Value="{DynamicResource PrimaryColor}"/>
                                                        <Setter Property="Opacity"
                                                                Value="0.9"/>
                                                 </VisualState.Setters>
                                          </VisualState>
                                          <VisualState x:Name="Disabled">
                                                 <VisualState.Setters>
                                                        <Setter Property="BackgroundColor"
                                                                Value="{DynamicResource PrimaryColor}"/>
                                                        <Setter Property="Opacity"
                                                                Value="0.5"/>
                                                 </VisualState.Setters>
                                          </VisualState>
                                   </VisualStateGroup>
                            </VisualStateGroupList>
                     </Setter>
              </Style>

              <!-- Status button base + selected highlight -->
              <Style x:Key="StatusButtonStyle"
                     TargetType="Button">
                     <Setter Property="BackgroundColor"
                             Value="{DynamicResource ControlBackgroundColor}"/>
                     <Setter Property="TextColor"
                             Value="{DynamicResource PrimaryTextColor}"/>
                     <Setter Property="Padding"
                             Value="10,6"/>
                     <Setter Property="CornerRadius"
                             Value="10"/>
                     <Setter Property="BorderColor"
                             Value="{DynamicResource CardBorder}"/>
                     <Setter Property="BorderWidth"
                             Value="1"/>
              </Style>
       </ContentPage.Resources>

       <ScrollView>
              <VerticalStackLayout Padding="20"
                                   Spacing="16">

                     <Image Source="{Binding ImagePath}"
                            HeightRequest="200"
                            Aspect="AspectFit"
                            BackgroundColor="{StaticResource AccentColor}"/>

                     <Label Text="{Binding Title}"
                            FontSize="24"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>

                     <Label Text="{Binding Author}"
                            FontSize="18"
                            HorizontalOptions="Center"
                            TextColor="{StaticResource TextColor}"/>

                     <Grid ColumnDefinitions="Auto,*"
                           RowDefinitions="Auto,Auto,Auto,Auto,Auto, Auto, Auto"
                           RowSpacing="8">
                            <Label Text="Status:"
                                   Grid.Row="0"
                                   Grid.Column="0"/>
                            <Label Text="{Binding Status}"
                                   Grid.Row="0"
                                   Grid.Column="1"/>
                            <Label Text="Pages:"
                                   Grid.Row="1"
                                   Grid.Column="0"/>
                            <Label Text="{Binding Pages}"
                                   Grid.Row="1"
                                   Grid.Column="1"/>
                            <Label Text="Subject:"
                                   Grid.Row="2"
                                   Grid.Column="0"/>
                            <Label Text="{Binding Subject}"
                                   Grid.Row="2"
                                   Grid.Column="1"/>
                            <Label Text="Vibe:"
                                   Grid.Row="3"
                                   Grid.Column="0"/>
                            <Label Text="{Binding Vibe}"
                                   Grid.Row="3"
                                   Grid.Column="1"/>
                            <Label Text="Source:"
                                   Grid.Row="4"
                                   Grid.Column="0"/>
                            <Label Text="{Binding Source}"
                                   Grid.Row="4"
                                   Grid.Column="1"/>
                            <Label Text="Country: "
                                   Grid.Row="5"
                                   Grid.Column="0"/>
                            <Label Text="{Binding Country}"
                                   Grid.Row="5"
                                   Grid.Column="1"/>
                            <Label Text="Year:"
                                   Grid.Row="6"
                                   Grid.Column="0"/>
                            <Label Text="{Binding YearPublished}"
                                   Grid.Row="6"
                                   Grid.Column="1"/>
                     </Grid>

                     <!-- Canon Button -->
                     <Button x:Name="CanonButton"
                             Style="{StaticResource TinyPrimaryButton}"
                             Text="{Binding CanonButtonText}"
                             Clicked="OnCanonButtonClicked"/>
                     <Button  x:Name="DeleteButton"
                              Style="{StaticResource TinyPrimaryButton}"
                              Text="Delete"
                              Clicked="OnDeleteButtonClicked"/>


                     <!-- Status Buttons -->
                     <Label Text="Change Status:"
                            FontAttributes="Bold"/>
                     <HorizontalStackLayout Spacing="8">
                            <Button Text="TBR"
                                          Style="{StaticResource StatusButtonStyle}"
                                    Command="{Binding SetStatusCommand}"
                                          CommandParameter="TBR">
                                   <Button.Triggers>
                                          <DataTrigger TargetType="Button"
                                                        Binding="{Binding Status}"
                                                        Value="TBR">
                                                 <Setter Property="BorderColor"
                                                               Value="{DynamicResource PrimaryColor}"/>
                                                 <Setter Property="BorderWidth"
                                                               Value="2"/>
                                          </DataTrigger>
                                   </Button.Triggers>
                            </Button>

                            <Button Text="Current"
                                          Style="{StaticResource StatusButtonStyle}"
                                    Command="{Binding SetStatusCommand}"
                                          CommandParameter="CurrentReads">
                                   <Button.Triggers>
                                          <DataTrigger TargetType="Button"
                                                        Binding="{Binding Status}"
                                                        Value="CurrentReads">
                                                 <Setter Property="BorderColor"
                                                               Value="{DynamicResource PrimaryColor}"/>
                                                 <Setter Property="BorderWidth"
                                                               Value="2"/>
                                          </DataTrigger>
                                   </Button.Triggers>
                            </Button>

                            <Button Text="Read"
                                          Style="{StaticResource StatusButtonStyle}"
                                    Command="{Binding SetStatusCommand}"
                                          CommandParameter="Read">
                                   <Button.Triggers>
                                          <DataTrigger TargetType="Button"
                                                        Binding="{Binding Status}"
                                                        Value="Read">
                                                 <Setter Property="BorderColor"
                                                               Value="{DynamicResource PrimaryColor}"/>
                                                 <Setter Property="BorderWidth"
                                                               Value="2"/>
                                          </DataTrigger>
                                   </Button.Triggers>
                            </Button>

                            <Button Text="DNF"
                                          Style="{StaticResource StatusButtonStyle}"
                                    Command="{Binding SetStatusCommand}"
                                          CommandParameter="DNF">
                                   <Button.Triggers>
                                          <DataTrigger TargetType="Button"
                                                        Binding="{Binding Status}"
                                                        Value="DNF">
                                                 <Setter Property="BorderColor"
                                                               Value="{DynamicResource PrimaryColor}"/>
                                                 <Setter Property="BorderWidth"
                                                               Value="2"/>
                                          </DataTrigger>
                                   </Button.Triggers>
                            </Button>
                     </HorizontalStackLayout>


              </VerticalStackLayout>
       </ScrollView>
</ContentPage>
