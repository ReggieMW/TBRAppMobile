<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:TBRAppMobile.Converters"
             x:Class="TBRAppMobile.Pages.AddBookPage"
             x:Name="AddBookPageInstance"
             Title="Add a Book"
             BackgroundColor="{StaticResource AccentColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">

            <!-- Section: Header -->
            <Label Text="➕ Add a Book"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Start"/>

            <!-- Section: Google Books Search -->
            <Label Text="Search Google Books"
                   FontSize="18"
                   FontAttributes="Bold"/>
            <Entry x:Name="SearchEntry"
                   Placeholder="Search title or author"
                   Text="{Binding SearchQuery}"/>

            <!-- Conditional Search Results Area -->
            <ContentView IsVisible="{Binding IsSearchDropdownVisible}">
                <CollectionView ItemsSource="{Binding SearchResults}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedSearchResult}"
                                HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10"
                                   Margin="5"
                                   BackgroundColor="{StaticResource CardBackground}"
                                   HasShadow="True"
                                   CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">
                                    <Image Grid.Column="0"
                                           Source="{Binding IconPath}"
                                           WidthRequest="40"
                                           HeightRequest="60"
                                           Aspect="AspectFill"/>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Title}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="Black"/>
                                        <Label Text="{Binding Author}"
                                               FontSize="13"
                                               TextColor="DimGray"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ContentView>

            <!-- Section: Book Details -->
            <Label Text="Book Details"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Entry Placeholder="Title"
                   PlaceholderColor="{StaticResource PrimaryColor}"
                   Text="{Binding BookTitle}"
                   TextColor="{StaticResource TextColor}"/>

            <Entry Placeholder="Author"
                   PlaceholderColor="{StaticResource PrimaryColor}"
                   Text="{Binding AuthorText}"
                   TextColor="{StaticResource TextColor}"
                   TextChanged="OnAuthorTextChanged"/>
            <CollectionView ItemsSource="{Binding FilteredAuthorSuggestions}"
                            IsVisible="{Binding IsAuthorSuggestionsVisible}"
                            SelectionMode="Single"
                            HeightRequest="100">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.SelectAuthorCommand, Source={x:Reference AddBookPageInstance}}"
                                                      CommandParameter="{Binding .}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Entry Placeholder="Country"
                   PlaceholderColor="{StaticResource PrimaryColor}"
                   Text="{Binding CountryText}"
                   TextColor="{StaticResource TextColor}"
                   TextChanged="OnCountryTextChanged"/>
            <CollectionView ItemsSource="{Binding FilteredCountrySuggestions}"
                            IsVisible="{Binding IsCountrySuggestionsVisible}"
                            SelectionMode="Single"
                            HeightRequest="100">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.SelectCountryCommand, Source={x:Reference AddBookPageInstance}}"
                                                      CommandParameter="{Binding .}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Entry Placeholder="Year Published"
                   PlaceholderColor="{StaticResource PrimaryColor}"
                   Keyboard="Numeric"
                   Text="{Binding YearText}"
                   TextColor="{StaticResource TextColor}"/>
            <Entry Placeholder="Pages"
                   Keyboard="Numeric"
                   PlaceholderColor="{StaticResource PrimaryColor}"
                   Text="{Binding PagesText}"
                   TextColor="{StaticResource TextColor}"/>

            <!-- Section: Subject -->
            <Label Text="Subject"
                   FontSize="18"
                   FontAttributes="Bold"/>
            <Picker Title="Select a Subject"
                    TitleColor="{StaticResource PrimaryColor}"
                    ItemsSource="{Binding SubjectSuggestions}"
                    SelectedItem="{Binding SelectedSubject}"
                    BackgroundColor="{StaticResource CardBackground}"/>
            <Entry Placeholder="Or enter your own subject"
                   PlaceholderColor="{StaticResource PrimaryColor}"
                   Text="{Binding SubjectText}"
                   TextColor="{StaticResource TextColor}"
                   TextChanged="OnSubjectTextChanged"/>
            <CollectionView ItemsSource="{Binding FilteredSubjectsSuggestions}"
                            IsVisible="{Binding IsSubjectsSuggestionsVisible}"
                            SelectionMode="Single"
                            HeightRequest="100">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.SelectSubjectsCommand, Source={x:Reference AddBookPageInstance}}"
                                                      CommandParameter="{Binding .}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Section: Vibe -->
            <Label Text="Vibe"
                   FontSize="18"
                   FontAttributes="Bold"/>
            <Picker Title="Select a Vibe"
                    TitleColor="{StaticResource PrimaryColor}"
                    ItemsSource="{Binding VibeSuggestions}"
                    SelectedItem="{Binding SelectedVibe}"
                    BackgroundColor="{StaticResource CardBackground}"/>
            <Entry Placeholder="Or enter your own vibe"
                   PlaceholderColor="{StaticResource PrimaryColor}"
                   Text="{Binding VibeText}"
                   TextChanged="OnVibeTextChanged"/>
            <CollectionView ItemsSource="{Binding FilteredVibeSuggestions}"
                            IsVisible="{Binding IsVibeSuggestionsVisible}"
                            SelectionMode="Single"
                            HeightRequest="60">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.SelectVibeCommand, Source={x:Reference AddBookPageInstance}}"
                                                      CommandParameter="{Binding .}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Section: Source -->
<Label Text="Source"
       FontSize="18"
       FontAttributes="Bold" />

<!-- The top-5 picker -->
<Picker Title="Select a Source"
        TitleColor="{StaticResource PrimaryColor}"
        ItemsSource="{Binding SourceSuggestions}"
        SelectedItem="{Binding SelectedSource}"
        BackgroundColor="{StaticResource CardBackground}" />

<!-- Free-text entry that triggers inline suggestions -->
<Entry Placeholder="Or enter your own source"
       PlaceholderColor="{StaticResource PrimaryColor}"
       Text="{Binding SourceText}"
       TextColor="{StaticResource TextColor}"
       TextChanged="OnSourceTextChanged" />

<!-- Inline dropdown suggestions (tap to select) -->
<CollectionView ItemsSource="{Binding FilteredSourceSuggestions}"
                IsVisible="{Binding IsSourceSuggestionsVisible}"
                SelectionMode="Single"
                HeightRequest="60">
    <CollectionView.ItemTemplate>
        <DataTemplate>
            <Label Text="{Binding .}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BindingContext.SelectSourceCommand, Source={x:Reference AddBookPageInstance}}"
                                          CommandParameter="{Binding .}" />
                </Label.GestureRecognizers>
            </Label>
        </DataTemplate>
    </CollectionView.ItemTemplate>
</CollectionView>


            <!-- Section: Icon Picker -->
            <Label Text="Select an Icon or Upload"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <HorizontalStackLayout Spacing="10"
                    Margin="0,0,0,6">
                <Button Text="📷 Use Camera"
                        Clicked="OnCameraClicked"/>
                <Button Text="📁 Upload Image"
                        Clicked="OnUploadClicked"/>
            </HorizontalStackLayout>

            <!-- Compact, no background, two short rows of ~48px thumbnails -->
            <CollectionView x:Name="IconPicker"
                            ItemsSource="{Binding DefaultIcons}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedIcon}"
                            BackgroundColor="Transparent"
                            ItemSizingStrategy="MeasureAllItems"
                            Margin="0"
                            HeightRequest="112">
                <CollectionView.ItemsLayout>
                    <!-- Tight grid; tweak Span if you want more/less columns -->
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{OnIdiom Phone=7, Tablet=9, Desktop=10}"
                                     HorizontalItemSpacing="6"
                                     VerticalItemSpacing="6"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- No background—blends with page. Only a thin stroke when selected. -->
                        <Border Padding="2"
                                Margin="2"
                                Background="Transparent"
                                StrokeThickness="0"
                                Stroke="Transparent">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal"/>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke"
                                                    Value="{StaticResource PrimaryColor}"/>
                                            <Setter Property="StrokeThickness"
                                                    Value="2"/>
                                            <Setter Property="Scale"
                                                    Value="0.98"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Image Source="{Binding}"
                                   HeightRequest="48"
                                   WidthRequest="48"
                                   Aspect="AspectFit"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>




            <!-- Selected cover preview + Save -->
            <VerticalStackLayout Spacing="10"
                                 VerticalOptions="Center">
                <Frame Padding="8"
                       HasShadow="False"
                       HorizontalOptions="Center">
                    <Image Source="{Binding SelectedIcon, TargetNullValue=book_cyan.png}"
                           WidthRequest="120"
                           HeightRequest="180"
                           Aspect="AspectFill"/>
                </Frame>

                <Button Text="Save Book"
                        Clicked="OnSaveClicked"
                        HorizontalOptions="Fill"
                        TextColor="{StaticResource TextColor}"/>
            </VerticalStackLayout>
            <Label x:Name="StatusLabel"
                   TextColor="{StaticResource PrimaryColor}"
                   FontSize="14"
                   IsVisible="False"/>
        </VerticalStackLayout>

    </ScrollView>
</ContentPage>
