<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TBRAppMobile.Views"
    x:Class="TBRAppMobile.Pages.CurrentReadsPage"
    Title="The Nightstand Pile"
    BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="📖 Currently Reading"
                   FontSize="24"
                   FontFamily="Georgia"
                   TextColor="{StaticResource TextColor}"
                   HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,Auto,Auto" BackgroundColor="Transparent">
                <Picker x:Name="SortPicker"
                        Title="Sort by"
                        SelectedIndex="0"
                        BackgroundColor="Transparent">
                    <Picker.Items>
                        <x:String>Title</x:String>
                        <x:String>Author</x:String>
                        <x:String>YearPublished</x:String>
                        <x:String>Pages</x:String>
                        <x:String>Id</x:String>
                    </Picker.Items>
                </Picker>

                <Switch x:Name="AscSwitch"
                        Grid.Column="1"/>

                <Entry x:Name="SearchEntry"
                       Grid.Column="2"
                       Placeholder="Search"
                       BackgroundColor="Transparent" />
            </Grid>

            <CollectionView x:Name="BookList"
                            SelectionMode="Single"
                            SelectionChanged="OnBookSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <views:BookCard
                            BookId="{Binding Id}"
                            Title="{Binding Title}"
                            Author="{Binding Author}"
                            IconPath="{Binding IconPath}"
                            Pages="{Binding Pages}"
                            Subject="{Binding Subject}"
                            Vibe="{Binding Vibe}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
