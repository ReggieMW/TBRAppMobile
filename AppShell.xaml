<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TBRAppMobile.Pages"
    x:Class="TBRAppMobile.AppShell"
    FlyoutBackgroundColor="{StaticResource BackgroundColor}"
    FlyoutItemIsVisible="True"
    TitleColor="{StaticResource TextColor}">

    <!-- CURRENTLY READING -->
    <FlyoutItem Title="Currently Reading" Route="CurrentReadsPage">
        <ShellContent ContentTemplate="{DataTemplate pages:CurrentReadsPage}" />
    </FlyoutItem>

    <!-- TBR LIST -->
    <FlyoutItem Title="TBR List" Route="TBRListPage">
        <ShellContent ContentTemplate="{DataTemplate pages:TBRListPage}" />
    </FlyoutItem>

    <!-- ADD BOOK -->
    <FlyoutItem Title="Add Book" Route="AddBookPage">
        <ShellContent ContentTemplate="{DataTemplate pages:AddBookPage}" />
    </FlyoutItem>

    <!-- READ -->
    <FlyoutItem Title="Read Books" Route="ReadListPage">
        <ShellContent ContentTemplate="{DataTemplate pages:ReadListPage}" />
    </FlyoutItem>

    <!-- DNF -->
    <FlyoutItem Title="Did Not Finish" Route="DNFPage">
        <ShellContent ContentTemplate="{DataTemplate pages:DNFPage}" />
    </FlyoutItem>

    <!-- MY CANON -->
    <FlyoutItem Title="My Canon" Route="MyCanonPage">
        <ShellContent ContentTemplate="{DataTemplate pages:MyCanonPage}" />
    </FlyoutItem>

</Shell>
