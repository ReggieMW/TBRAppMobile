<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TBRAppMobile"
             x:Class="TBRAppMobile.App">
             <!-- MAUI installed to make IOS, Android, and Windows compatible app-->
    <Application.Resources>
    <!-- Color Palette -->
    <Color x:Key="PrimaryColor">#A53D2C</Color>
    <Color x:Key="BackgroundColor">#EFE1C1</Color>
    <Color x:Key="TextColor">#1A1A1A</Color>
    <Color x:Key="AccentColor">#D3A63B</Color>
    <Color x:Key="CardBackground">#FDF5E6</Color>
    <Color x:Key="HeaderBackground">#B0815B</Color>

    <!-- Entry Style -->
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="Margin" Value="0,5" />
    </Style>

    <!-- Button Style -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Label Style -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Georgia" />
    </Style>

    <!-- Page Background -->
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundColor}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
    </Style>
</Application.Resources>

</Application>
