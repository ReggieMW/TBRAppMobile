<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TBRAppMobile.Views.BookCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root"
    BackgroundColor="Transparent">

    <!-- card surface -->
    <Frame Padding="12"
           CornerRadius="12"
           HasShadow="True"
           BackgroundColor="{StaticResource BackgroundColor}"
           BorderColor="{StaticResource PrimaryColor}">

        <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="12"
                BackgroundColor="Transparent">
            <Image Grid.Column="0"
                   WidthRequest="54"
                    HeightRequest="54"
                   Aspect="AspectFit"
                   Source="{Binding IconPath, Source={x:Reference root}}"/>

            <VerticalStackLayout Grid.Column="1"
                    Spacing="4"
                    BackgroundColor="Transparent">
                <Label Text="{Binding Title, Source={x:Reference root}}"
                       FontSize="18"
                        FontAttributes="Bold"
                       BackgroundColor="Transparent"
                       TextColor="{StaticResource TextColor}"/>

                <Label Text="{Binding Author, Source={x:Reference root}}"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       TextColor="{StaticResource TextColor}"/>

                <!-- Chips -->
    <HorizontalStackLayout Spacing="8" Margin="0,6,0,0" BackgroundColor="{StaticResource BackgroundColor}">

        <!-- Subject -->
        <Border Padding="10,4"
                BackgroundColor="{DynamicResource PrimaryColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSubjectChipTapped"/>
            </Border.GestureRecognizers>
            <Label Text="{Binding Subject, Source={x:Reference root}}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="White"/>
        </Border>

        <!-- Vibe -->
        <Border Padding="10,4"
                BackgroundColor="{DynamicResource PrimaryColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnVibeChipTapped"/>
            </Border.GestureRecognizers>
            <Label Text="{Binding Vibe, Source={x:Reference root}}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="White"/>
        </Border>

        <!-- Author -->
        <Border Padding="10,4"
                BackgroundColor="{DynamicResource PrimaryColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAuthorChipTapped"/>
            </Border.GestureRecognizers>
            <Label Text="{Binding Author, Source={x:Reference root}}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="White"/>
        </Border>

        <!-- Year -->
        <Border Padding="10,4"
                BackgroundColor="{DynamicResource PrimaryColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnYearChipTapped"/>
            </Border.GestureRecognizers>
            <Label Text="{Binding YearPublished, Source={x:Reference root}, StringFormat='📅 {0}'}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="White"/>
        </Border>

        <!-- Country -->
        <Border Padding="10,4"
                BackgroundColor="{DynamicResource PrimaryColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCountryChipTapped"/>
            </Border.GestureRecognizers>
            <Label Text="{Binding Country, Source={x:Reference root}}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="White"/>
        </Border>

        <!-- Source -->
        <Border Padding="10,4"
                BackgroundColor="{DynamicResource PrimaryColor}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSourceChipTapped"/>
            </Border.GestureRecognizers>
            <Label Text="{Binding Source, Source={x:Reference root}}"
                   FontSize="12" FontAttributes="Bold"
                   TextColor="White"/>
        </Border>


                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Frame>
</ContentView>
