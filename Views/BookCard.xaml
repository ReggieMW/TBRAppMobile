<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TBRAppMobile.Views.BookCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="root"
    BackgroundColor="Transparent">

    <!-- card surface -->
    <Frame Padding="12"
           CornerRadius="12"
           HasShadow="True"
           BackgroundColor="{StaticResource BackgroundColor}"
           BorderColor="{StaticResource PrimaryColor}">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" BackgroundColor="Transparent">
            <Image Grid.Column="0"
                   WidthRequest="54" HeightRequest="54"
                   Aspect="AspectFit"
                   Source="{Binding IconPath, Source={x:Reference root}}" />

            <VerticalStackLayout Grid.Column="1" Spacing="4" BackgroundColor="Transparent">
                <Label Text="{Binding Title, Source={x:Reference root}}"
                       FontSize="18" FontAttributes="Bold"
                       BackgroundColor="Transparent"
                       TextColor="{StaticResource TextColor}" />

                <Label Text="{Binding Author, Source={x:Reference root}}"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       TextColor="{StaticResource TextColor}" />

                <!-- chips -->
                <HorizontalStackLayout Spacing="8" BackgroundColor="Transparent">
                    <Border Padding="6,2"
                            BackgroundColor="{StaticResource AccentColor}"
                            Stroke="{StaticResource PrimaryColor}"
                            StrokeThickness="1"
                            >
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Subject, Source={x:Reference root}}"
                               BackgroundColor="Transparent"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TextColor}" />
                    </Border>

                    <Border Padding="6,2"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            Stroke="{StaticResource PrimaryColor}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Vibe, Source={x:Reference root}}"
                               BackgroundColor="Transparent"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TextColor}" />
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Frame>
</ContentView>
